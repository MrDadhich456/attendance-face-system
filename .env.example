# =============================================================================
# Environment Variables — Attendance System
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# =============================================================================

# PostgreSQL connection string (AWS RDS)
DATABASE_URL=postgresql://username:password@your-rds-endpoint:5432/postgres

# Set to true if your RDS requires SSL (recommended)
DATABASE_SSL=true

# Admin dashboard password — CHANGE THIS!
ADMIN_PASSWORD=your_secure_admin_password_here

# Server port (nginx proxies from 80 → 3000)
PORT=3000

# Environment
NODE_ENV=production

# Timezone for attendance windows
TIMEZONE=Asia/Kolkata
